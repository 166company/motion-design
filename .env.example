# ---- Rejim (keyfiyyət birinci: OpenAI ƏSAS, pulsuzlar yalnız EHTİYAT) ----
# openai-first (default): əvvəl OpenAI, yalnız 429/5xx/kvota/şəbəkə xətasında pulsuza keçir
#   openai: yalnız OpenAI · auto: əvvəl pulsuzlar → OpenAI · free: yalnız pulsuz (əl ilə seçim)
LLM_ENGINE=openai-first
# openai-first (default): OpenAI səs + Whisper hizalaması, səhnə xətasında edge-tts ehtiyat
#   openai: yalnız OpenAI · edge: yalnız pulsuz edge-tts · auto: əvvəl edge → OpenAI
TTS_ENGINE=openai-first
# openai (default) | nvidia | auto (NVIDIA, xəta olsa OpenAI)
IMAGE_ENGINE=openai
# 1 (default): "yenilik bloku" — hər post əvvəlkilərdən fərqli olsun · 0: söndür
NOVELTY=1
AUTO_PUBLISH=

# ---- OpenAI (ƏSAS — ödənişli) ----
OPENAI_API_KEY=
# Model defaultları: OPENAI_MODEL=gpt-5.4-mini · OPENAI_CREATIVE_MODEL=gpt-5.5
# OPENAI_MODEL=
# OPENAI_CREATIVE_MODEL=
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
# OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=marin

# ---- Pulsuz provayderlər — EHTİYAT ÜÇÜN (istəyə bağlı) ----
# Açarı olan avtomatik qoşulur; OpenAI alınmayanda və ya LLM_ENGINE=auto/free olanda işlənir.
# Alternativləri əl ilə müqayisə: npx tsx pipeline/compare.ts carousel|poster|story|script
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GH_MODELS_TOKEN=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
# LLM_PROVIDERS=nvidia,gemini,groq,cerebras,github,openrouter,mistral,sambanova
# flux.1-schnell (kommersiya OK) | sd3.5-large — yalnız IMAGE_ENGINE=nvidia/auto olanda
NVIDIA_IMAGE_MODEL=flux.1-schnell
# rotate (Banu/Babek növbə ilə) | az-AZ-BanuNeural | az-AZ-BabekNeural — yalnız edge yolunda
TTS_VOICE=rotate

# ---- Pexels (pulsuz) ----
PEXELS_API_KEY=

# ---- Meta / Instagram + Facebook (System User token) ----
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
META_GRAPH_VERSION=

# ---- Audius (pulsuz, CC musiqi) ----
AUDIUS_API_TOKEN=
